# PERSONAL OS — environment template. Copy to .env and fill in. NEVER commit a real .env.

# Database — SQLite by default; switch to Postgres/Supabase later, e.g.
# postgresql+psycopg://user:password@host:5432/personal_os
DATABASE_URL=sqlite:///./personal_os.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional one-time admin seed (used only by the seed script / startup seed).
# If unset, no admin user is created. Do NOT hardcode a password in code.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# AI providers (all optional; configure in Settings later — keys are read from env only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Integrations (Phase 8 — see docs/INTEGRATIONS.md; secrets are env-only,
# never stored in the DB and never returned by the API)
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_BASE_URL=http://localhost:8000

# Security (Phase 9 — see docs/SECURITY.md)
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_COMMANDS_PER_MIN=60

# App
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
